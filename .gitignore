# ObfSymbolsEx - Visual C++ solution .gitignore

# ---- Build output ----
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/

# ---- MSBuild intermediate / log files ----
*.obj
*.iobj
*.ipdb
*.idb
*.ilk
*.exp
*.lib
*.tlog
*.recipe
*.lastbuildstate
*.ipch
vcpkg.applocal.log

# ---- Generated binaries (always rebuilt from source) ----
*.exe
*.dll
*.pdb

# ---- Visual Studio ----
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb

# ---- Tool output (regenerated by validate.ps1 / unit-tests.ps1) ----
*.sym
UnitTestResults/
